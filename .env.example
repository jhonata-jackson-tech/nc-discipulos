# =============================================================================
# Copie para `.env` e preencha. O `.env` fica fora do Git.
#
# Gere cada segredo com:  openssl rand -hex 32
# =============================================================================

# ------------------------------------------------------------------- dominio
# Dominio que aponta para o IP da VPS. O Caddy emite o certificado sozinho.
DOMAIN=cuidar.seudominio.com.br

# --------------------------------------------------------------------- banco
POSTGRES_DB=cuidar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Papeis de conexao. `authenticator` e do PostgREST, `auth_service` e do
# servico de autenticacao - nenhum dos dois e superusuario.
AUTHENTICATOR_PASSWORD=
AUTH_SERVICE_PASSWORD=

# ------------------------------------------------------------------- sessao
# Assina o JWT no servico de autenticacao e e conferido pelo PostgREST.
# Trocar este valor derruba todas as sessoes abertas. Minimo de 32 caracteres.
JWT_SECRET=

# ------------------------------------------------------ notificacoes push
# Opcionais: sem elas o app funciona inteiro, so nao avisa fora da tela.
# Gere uma vez com `npm run vapid` e nao troque depois - trocar derruba todas
# as inscricoes, e cada pessoa precisaria ligar o aviso de novo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# =============================================================================
# Somente na sua maquina (testes e scripts). Em producao nada disso e usado.
# =============================================================================

# Conexao direta com o Postgres do compose de desenvolvimento, publicado em
# 127.0.0.1:5432 por `docker-compose.dev.yml`.
DATABASE_URL=postgres://postgres:SENHA@localhost:5432/cuidar

# Opcional: aponta os testes end-to-end para uma aplicacao ja no ar. Sem esta
# variavel, o Playwright sobe o proprio Vite em uma porta so dele.
# E2E_BASE_URL=http://localhost:5173
