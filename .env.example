# URL do projeto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publica (anon / publishable). Nunca use a service_role no frontend.
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# --- Somente para testes de integracao/RLS locais (nunca commitar valores reais) ---
# Usada apenas por scripts em tests/integration para criar usuarios de teste.
SUPABASE_SERVICE_ROLE_KEY=
# URL usada pelo Playwright
E2E_BASE_URL=http://localhost:5173
