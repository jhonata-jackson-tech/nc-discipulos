{
  "name": "cuidar-gc-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/server.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
